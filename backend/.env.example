# --- Server ---
PORT=5000
NODE_ENV=development
# Isi 1 bila backend berada di belakang proxy/load balancer (AWS App Runner, ALB, CloudFront)
TRUST_PROXY=

# --- Basis data ---
# Lokal: mongodb://127.0.0.1:27017/laris · Atlas: mongodb+srv://<user>:<sandi>@<cluster>/laris
MONGO_URI=mongodb://127.0.0.1:27017/laris

# --- Autentikasi ---
# Wajib. Buat dengan: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Batas percobaan login per IP per 15 menit (NFR-03)
LOGIN_RATE_LIMIT=100

# --- CORS ---
# Satu atau beberapa domain frontend dipisah koma
CORS_ORIGIN=http://localhost:5173

# --- Cache laporan (detik) ---
CACHE_TTL=60

# --- Midtrans (opsional, QRIS) ---
# Kosongkan untuk mode simulasi. Ambil dari dashboard.sandbox.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Seed ---
# Seed menghapus seluruh data. Di NODE_ENV=production hanya berjalan bila diisi "ya"
SEED_IZINKAN=
